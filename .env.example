# Gnani Shop — copy to .env and fill in. Everything has a working default
# except the two keys that call outside services.

# --- Gnani Vachana (voice) — https://docs.gnani.ai ---
GNANI_API_KEY=
# Optional overrides (defaults shown)
# GNANI_STT_MODEL=prisma-v3.0
# GNANI_STT_LANGUAGE=indic-auto
# GNANI_STT_FORMAT=transcribe
# GNANI_TTS_MODEL=timbre-v3.0
# GNANI_TTS_VOICE=Shivani

# --- The agent's brain: any OpenAI-compatible provider ---
# groq (default) or nvidia. Both serve openai/gpt-oss-120b (+ gpt-oss-20b fallback).
LLM_PROVIDER=groq
GROQ_API_KEY=
NVIDIA_API_KEY=
# Optional: override the model ids
# LLM_MODEL=
# LLM_FALLBACK=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Use 127.0.0.1, not localhost — see backend/app/core/config.py.
FRONTEND_URL=http://127.0.0.1:3000
DATABASE_URL=sqlite:///./gnani_shop.db
# Postgres instead:
# DATABASE_URL=postgresql+psycopg://gnani:gnani@localhost:5432/gnani_shop

# --- Sign-in ---
# Google OAuth is optional: in development the login page offers demo buyer/merchant accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# Comma-separated emails that get the MERCHANT role on first Google login.
MERCHANT_EMAILS=

# --- Payments (demo money only) ---
# WALLET_STARTING_BALANCE_PAISE=200000
# AGENT_AUTOPAY_DEFAULT_LIMIT_PAISE=50000

# --- Optional: public HTTPS link so the mic works on a phone (browsers need HTTPS for microphones) ---
NGROK_AUTHTOKEN=
